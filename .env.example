# Copy this file to .env.local and fill in your own keys.
# Leave the values empty to run QuickQuote in DEMO MODE (no accounts needed;
# data is stored in your browser and metrics are simulated).

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Upstash -> Redis database -> REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

